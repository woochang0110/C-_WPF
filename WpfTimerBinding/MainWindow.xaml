<Window x:Class="WpfTimerBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTimerBinding"
        mc:Ignorable="d"
        Title="WpfTimerBinding" Height="250" Width="300">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Number 값이 ViewModel에서 UI로만 전달됨 -->
        <TextBlock Text="{Binding Number, Mode=OneWay}"
                   FontSize="48" HorizontalAlignment="Center"/>

        <!-- TextBox는 InputNumber와 바인딩됨.
             Enter를 눌러야만 ViewModel.InputNumber로 값이 적용됨 -->
        <TextBox Text="{Binding InputNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                 FontSize="24"
                 HorizontalAlignment="Center"
                 KeyDown="TextBox_KeyDown"
                 Width="100"
                 Margin="0,20,0,0"/>

        <!-- 버튼들 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Start" Width="80" Margin="5" Click="Start_Click"/>
            <Button Content="Stop" Width="80" Margin="5" Click="Stop_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
